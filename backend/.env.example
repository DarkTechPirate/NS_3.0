PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/nammasambandhi
JWT_SECRET=replace_with_a_long_random_secret

CLIENT_URL=http://localhost:5178
BACKEND_URL=http://localhost:5000

# Google OAuth — create credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Set to true and fill MINIO_* vars if you want to use MinIO for file storage
USE_MINIO=false
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_NAME=nammasambandhi

# Redis (used by BullMQ media worker)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
